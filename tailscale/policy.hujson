// Example/default ACLs for unrestricted connections.

// This file is under version control in a PUBLIC repository. Nothing in it
// grants access on its own -- an ACL is policy, not a credential, and reaching
// anything named here still requires a tailnet identity. But the file's natural
// growth is toward things that should not be public. Move it somewhere private
// (git-crypt in place, or out of the repository entirely) before adding any of:
//
//   - "groups" or "tests", which carry email addresses
//   - "tagOwners" naming a user rather than an autogroup
//   - "autoApprovers", which carries home and work subnet CIDRs
//   - device names, or any address outside the 100.64.0.0/10 tailnet range
{
	// Declare static groups of users. Use autogroups for all users or users with a specific role.
	// "groups": {
	//  	"group:example": ["alice@example.com", "bob@example.com"],
	// },

	// The case VMs run coding agents, so they are tagged rather than owned by a
	// user. The tag comes from the auth key they are installed with; see
	// documentation/case-install.md.
	"tagOwners": {
		"tag:agent": ["autogroup:admin"],
	},

	// Nothing grants tag:agent as a source. A prompt-injected agent on a case VM
	// can therefore reach no other tailnet device, murph's sshd included.
	"acls": [
		// Users reach their own devices. autogroup:self excludes tagged devices,
		// which is why the case VMs need the rule below.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self:*"],
		},
		// Covers mosh's UDP as well as TCP, since the rule names no protocol.
		{"action": "accept", "src": ["autogroup:member"], "dst": ["tag:agent:*"]},
		// Exit nodes, Mullvad's included, need this once the allow-all rule is gone.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:internet:*"],
		},
	],

	// Define postures that will be applied to all rules without any specific
	// srcPosture definition.
	// "defaultSrcPosture": [
	//      "posture:anyMac",
	// ],

	// Define device posture rules requiring devices to meet
	// certain criteria to access parts of your system.
	// "postures": {
	//      // Require devices running macOS, a stable Tailscale
	//      // version and auto update enabled for Tailscale.
	// 	"posture:autoUpdateMac": [
	// 	    "node:os == 'macos'",
	// 	    "node:tsReleaseTrack == 'stable'",
	// 	    "node:tsAutoUpdate",
	// 	],
	//      // Require devices running macOS and a stable
	//      // Tailscale version.
	// 	"posture:anyMac": [
	// 	    "node:os == 'macos'",
	// 	    "node:tsReleaseTrack == 'stable'",
	// 	],
	// },

	// Define users and devices that can use Tailscale SSH.
	"ssh": [
		// Allow all users to SSH into their own devices. "accept" rather than
		// Tailscale's default "check": check mode forces a periodic browser
		// re-authentication, which a phone cannot conveniently complete, and the
		// case VMs are reachable only this way.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
		},
		// The case VMs are tagged, so the rule above does not match them and this
		// one is their only route in. Users are named: autogroup:nonroot on a
		// tagged destination would admit any account on the VM.
		{
			"action": "accept",
			"src":    ["autogroup:member"],
			"dst":    ["tag:agent"],
			"users":  ["jackson", "root"],
		},
	],
	"nodeAttrs": [
		{"target": ["100.82.164.118"], "attr": ["mullvad"]},
	],

	// Test access rules every time they're saved.
	// "tests": [
	//  	{
	//  		"src": "alice@example.com",
	//  		"accept": ["tag:example"],
	//  		"deny": ["100.101.102.103:443"],
	//  	},
	// ],
}
